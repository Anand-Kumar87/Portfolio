# Copy this to .env.local and fill in your values

# MongoDB Connection (use MongoDB Atlas for production)
MONGODB_URI=

# JWT Secret (generate a strong random string)
JWT_SECRET=

# App URL (your Vercel domain)
NEXT_PUBLIC_APP_URL=

# Email Configuration
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Admin Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
